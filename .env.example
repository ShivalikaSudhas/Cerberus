# =====================================================================
# IoT Smart Home Surveillance System — Environment Configuration Template
# Copy this file to '.env' before launching the system:
#   cp .env.example .env
# =====================================================================

# ---------------------------------------------------------------------
# Camera Source Configuration
# ---------------------------------------------------------------------
# 0 for default integrated webcam, 1 for external USB camera,
# or RTSP/HTTP URL string for CCTV/Raspberry Pi stream
# Example RTSP: rtsp://admin:password@192.168.1.100:554/stream1
CAMERA_SOURCE=0

# Camera Resolution & Frame Rate
FRAME_WIDTH=640
FRAME_HEIGHT=480
FPS=30

# ---------------------------------------------------------------------
# Face Recognition & Alert Settings
# ---------------------------------------------------------------------
# LBPH Distance Threshold (lower = stricter match required; <= 70.0 is authorized match)
CONFIDENCE_THRESHOLD=70.0
LBPH_CONFIDENCE_THRESHOLD=70.0

# Anti-Spam Alert Cooldown (seconds delay between repeated alerts)
UNKNOWN_COOLDOWN_SECONDS=5.0

# Privacy Retention Policy (auto-delete intruder snapshots older than N days)
MAX_SNAPSHOT_RETENTION_DAYS=30

# ---------------------------------------------------------------------
# MQTT Alert Broker & Security Settings
# ---------------------------------------------------------------------
# Public test broker: test.mosquitto.org (Port 1883)
# Production broker: your-broker.com (Port 8883 with TLS)
MQTT_BROKER=test.mosquitto.org
MQTT_PORT=1883
MQTT_TOPIC=smarthome/lock/alerts

# TLS Encryption (True for Port 8883)
MQTT_USE_TLS=False

# Broker Authentication Credentials (leave blank if unauthenticated)
MQTT_USERNAME=
MQTT_PASSWORD=

# ---------------------------------------------------------------------
# Voice Notification Toggle
# ---------------------------------------------------------------------
# Set to False to disable local offline Text-To-Speech (TTS) audio warnings
ENABLE_VOICE_ALERT=True
